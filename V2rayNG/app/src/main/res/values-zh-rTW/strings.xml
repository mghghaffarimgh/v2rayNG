    <string name="title_vpn_share">VPN 分享 / 熱點</string>
    <string name="notification_channel_vpn_share">VPN 分享</string>
    <string name="vpn_share_notification_starting">正在開啟分享 Wi-Fi…</string>
    <string name="vpn_share_notification_running">正在透過 Wi-Fi「%1$s」分享 VPN</string>
    <string name="vpn_share_permission_denied">開啟 Wi-Fi 網路需要鄰近裝置權限（Android 13+）或位置權限</string>
    <string name="vpn_share_intro">讓其他手機、平板和電腦使用此 VPN。無 root 時，應用程式會開啟自己的 Wi-Fi 網路，其他裝置將本機設為代理；不使用代理的流量完全無法上網，因此不會洩漏。有 root 時，系統熱點、USB 和乙太網路共用無需在其他裝置上設定即可經過 VPN。</string>
    <string name="vpn_share_vpn_off">VPN 未連線。請先連線，否則其他裝置無法上網。</string>
