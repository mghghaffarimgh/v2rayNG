    <string name="title_vpn_share">VPN 共享 / 热点</string>
    <string name="notification_channel_vpn_share">VPN 共享</string>
    <string name="vpn_share_notification_starting">正在开启共享 Wi-Fi…</string>
    <string name="vpn_share_notification_running">正在通过 Wi-Fi\"%1$s\"共享 VPN</string>
    <string name="vpn_share_permission_denied">开启 Wi-Fi 网络需要附近设备权限（Android 13+）或位置权限</string>
    <string name="vpn_share_intro">让其他手机、平板和电脑使用此 VPN。无 root 时，应用会开启自己的 Wi-Fi 网络，其他设备将本机设为代理；不使用代理的流量根本无法上网，因此不会泄漏。有 root 时，系统热点、USB 和以太网共享无需在其他设备上设置即可经过 VPN。</string>
    <string name="vpn_share_vpn_off">VPN 未连接。请先连接，否则其他设备无法上网。</string>
    <string name="vpn_share_hotspot_title">Wi-Fi 共享（无需 root）</string>
    <string name="vpn_share_hotspot_switch">通过 Wi-Fi 共享</string>
    <string name="vpn_share_hotspot_summary">为其他设备开启 Wi-Fi 网络，并让它们通过代理使用 VPN</string>
