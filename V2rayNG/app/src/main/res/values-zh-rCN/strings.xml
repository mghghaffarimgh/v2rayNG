    <string name="vpn_share_wifi_credentials">Wi-Fi：%1$s\n密码：%2$s</string>
    <string name="vpn_share_wifi_qr_description">加入共享 Wi-Fi 的二维码</string>
    <string name="vpn_share_proxy_title">供其他设备使用的代理</string>
    <string name="vpn_share_no_address">尚无局域网地址。请开启 Wi-Fi 共享，或将本机和其他设备连接到同一 Wi-Fi。</string>
    <string name="vpn_share_address_hotspot">共享 Wi-Fi 上：%1$s</string>
    <string name="vpn_share_address_lan">本机所在网络：%1$s</string>
    <string name="vpn_share_proxy_type">代理类型：同一端口支持 SOCKS5 和 HTTP。</string>
    <string name="vpn_share_no_password">代理没有密码。在共享 Wi-Fi 上只有知道其密码的人才能访问，但在公共 Wi-Fi 上任何人都可能使用您的 VPN。请在设置中设置 SOCKS 用户名和密码。</string>
    <string name="vpn_share_howto_title">连接其他设备</string>
    <string name="vpn_share_howto_body">加入上方的 Wi-Fi（用相机扫描二维码），然后将代理设置为显示的地址和端口：\n• Android：Wi-Fi &gt; 该网络 &gt; 修改 &gt; 高级 &gt; 代理：手动。\n• iPhone/iPad：设置 &gt; Wi-Fi &gt; ⓘ &gt; 配置代理：手动。\n• Windows：设置 &gt; 网络和 Internet &gt; 代理 &gt; 使用代理服务器。\n• macOS：系统设置 &gt; 网络 &gt; Wi-Fi &gt; 详细信息 &gt; 代理。\n忽略系统代理的应用和游戏无法通过共享使用；如需完全覆盖，请在其他设备上使用代理客户端（例如 v2rayN 或配置 SOCKS 服务器的 v2rayNG）。</string>
    <string name="vpn_share_root_title">完全共享（root）</string>
    <string name="vpn_share_root_summary">让系统热点、USB 和以太网共享上的设备经过 VPN；无需设置代理。下次启动 VPN 时生效。</string>
    <string name="vpn_share_open_tethering">打开热点和网络共享设置</string>
    <string name="vpn_share_pc_title">通过数据线与电脑共享</string>
    <string name="vpn_share_pc_body">有 root：开启完全共享，用 USB 连接电脑并开启 USB 网络共享（或通过转接器使用以太网共享）；电脑流量将经过 VPN。无 root：将电脑连接到共享 Wi-Fi 或与本机相同的 Wi-Fi，并设置上方显示的代理。无 root 时，Android 自带的热点和 USB 共享会绕过 VPN。</string>
